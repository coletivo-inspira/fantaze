import { motion } from 'framer-motion';
import { CalendarPlus, CheckCircle2, MessageCircle, RotateCcw } from 'lucide-react';
import { getThemeForDate } from '../../data/themes';
import { restaurant } from '../../data/restaurant';
import { formatLongDate } from '../../lib/format';
import type { Reservation } from '../../types';
import Button from '../ui/Button';
import Decor from '../ui/Decor';
import { experiences } from './reservationOptions';

function buildICS(r: Reservation): string {
  const [h, m] = r.time.split(':').map(Number);
  const date = r.date.replace(/-/g, '');
  const pad = (n: number) => String(n).padStart(2, '0');
  const start = `${date}T${pad(h)}${pad(m)}00`;
  const end = `${date}T${pad(Math.min(h + 2, 23))}${pad(m)}00`;
  return [
    'BEGIN:VCALENDAR',
    'VERSION:2.0',
    'PRODID:-//Fantaze//Reservas//PT',
    'BEGIN:VEVENT',
    `UID:${r.code}@fantaze.com.br`,
    `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').split('.')[0]}Z`,
    `DTSTART:${start}`,
    `DTEND:${end}`,
    `SUMMARY:Fantazê — mesa para ${r.people}`,
    `LOCATION:${restaurant.address.street}, ${restaurant.address.district}, ${restaurant.address.city}`,
    `DESCRIPTION:Código da reserva ${r.code}`,
    'END:VEVENT',
    'END:VCALENDAR',
  ].join('\r\n');
}

function downloadICS(r: Reservation) {
  const blob = new Blob([buildICS(r)], { type: 'text/calendar;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `fantaze-${r.code}.ics`;
  a.click();
  URL.revokeObjectURL(url);
}

export default function ReservationSuccess({ reservation, onReset }: { reservation: Reservation; onReset: () => void }) {
  const theme = getThemeForDate(reservation.date);
  const exp = experiences.find((e) => e.id === reservation.experience);
  const whatsapp = `https://wa.me/55${restaurant.phone.replace(/\D/g, '')}?text=${encodeURIComponent(
    `Olá! Fiz a solicitação de reserva ${reservation.code} para ${formatLongDate(reservation.date)} às ${reservation.time}.`,
  )}`;

  return (
    <motion.div
      initial={{ opacity: 0, scale: 0.96, y: 20 }}
      animate={{ opacity: 1, scale: 1, y: 0 }}
      transition={{ duration: 0.6, ease: [0.16, 1, 0.3, 1] }}
      className="relative overflow-hidden rounded-[2.5rem] bg-brand-indigo p-8 text-white sm:p-12"
    >
      <Decor name="butterfly" float className="-right-4 top-6 w-24 sm:w-32" />
      <Decor name="sparkle" twinkle className="left-6 bottom-8 w-12 opacity-80" />

      <div className="relative">
        <CheckCircle2 size={44} className="text-brand-amber" />
        <h2 className="mt-4 text-4xl sm:text-5xl">Solicitação recebida!</h2>
        <p className="mt-3 max-w-lg text-white/75">
          Obrigado, {reservation.name.split(' ')[0]}! Nossa equipe confirma sua mesa por WhatsApp em até 2 horas.
        </p>

        <div className="mt-8 grid gap-4 rounded-3xl bg-white/10 p-6 backdrop-blur sm:grid-cols-2">
          <Info label="Código" value={reservation.code} strong />
          <Info label="Data" value={formatLongDate(reservation.date)} />
          <Info label="Horário" value={reservation.time} />
          <Info label="Pessoas" value={String(reservation.people)} />
          <Info label="Experiência" value={exp?.title ?? ''} />
          <Info label="Tema" value={theme?.name ?? 'A definir pela votação'} />
        </div>

        <div className="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button variant="secondary" onClick={() => downloadICS(reservation)} icon={<CalendarPlus size={18} />}>
            Adicionar ao calendário
          </Button>
          <Button variant="light" href={whatsapp} external icon={<MessageCircle size={18} />}>
            Falar no WhatsApp
          </Button>
          <button
            type="button"
            onClick={onReset}
            className="inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-bold text-white/80 transition-colors hover:text-white"
          >
            <RotateCcw size={16} /> Nova reserva
          </button>
        </div>
      </div>
    </motion.div>
  );
}

function Info({ label, value, strong }: { label: string; value: string; strong?: boolean }) {
  return (
    <div>
      <p className="text-[11px] font-extrabold uppercase tracking-[0.25em] text-brand-amber">{label}</p>
      <p className={strong ? 'mt-1 font-display text-2xl tracking-wider' : 'mt-1 text-lg font-bold capitalize'}>{value}</p>
    </div>
  );
}
