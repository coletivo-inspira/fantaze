import { ArrowRight } from 'lucide-react';
import { useVotes } from '../../hooks/useVotes';
import Button from '../ui/Button';
import Decor from '../ui/Decor';
import Reveal from '../ui/Reveal';
import SectionHeading from '../ui/SectionHeading';
import ThemeIcon from '../vote/ThemeIcon';

export default function VotePreview() {
  const { tally, totalVotes, loading } = useVotes();
  const top = tally.slice(0, 3);

  return (
    <section className="relative overflow-hidden bg-brand-indigo py-24 text-white">
      <Decor name="spiral" float className="right-[8%] top-10 w-20 opacity-70" />
      <Decor name="butterfly" float delay={1} className="bottom-10 left-[6%] w-24 opacity-70" />

      <div className="relative mx-auto grid max-w-7xl items-center gap-14 px-6 md:px-10 lg:grid-cols-2">
        <div>
          <SectionHeading
            tone="dark"
            kicker="Próximos temas"
            title="Para onde o Fantazê vai em seguida?"
            subtitle="Quem decide é você. Vote no universo que quer ver ganhar vida no salão nos próximos meses."
          />
          <Reveal delay={0.1}>
            <p className="mt-6 text-sm text-white/60">
              {loading ? 'Carregando votos…' : `${totalVotes.toLocaleString('pt-BR')} votos registrados até agora`}
            </p>
            <Button to="/proximos-temas" variant="secondary" size="lg" className="mt-6" icon={<ArrowRight size={18} />}>
              Votar agora
            </Button>
          </Reveal>
        </div>

        <ol className="space-y-4">
          {top.map((t, i) => {
            const pct = totalVotes ? (t.votes / totalVotes) * 100 : 0;
            return (
              <Reveal key={t.id} delay={i * 0.1}>
                <li className="rounded-3xl border border-white/10 bg-white/[0.07] p-5 backdrop-blur">
                  <div className="flex items-center gap-4">
                    <span className="font-display text-4xl text-brand-amber">{i + 1}</span>
                    <span
                      className="grid h-12 w-12 place-items-center rounded-2xl"
                      style={{ background: `linear-gradient(135deg, ${t.colors[0]}, ${t.colors[1]})` }}
                    >
                      <ThemeIcon name={t.icon} />
                    </span>
                    <div className="min-w-0 flex-1">
                      <p className="truncate font-display text-xl">{t.name}</p>
                      <div className="mt-2 h-2 overflow-hidden rounded-full bg-white/10">
                        <div
                          className="h-full rounded-full transition-all duration-1000"
                          style={{ width: `${pct}%`, background: `linear-gradient(90deg, ${t.colors[0]}, ${t.colors[1]})` }}
                        />
                      </div>
                    </div>
                    <span className="text-sm font-bold text-white/70">{pct.toFixed(0)}%</span>
                  </div>
                </li>
              </Reveal>
            );
          })}
        </ol>
      </div>
    </section>
  );
}
